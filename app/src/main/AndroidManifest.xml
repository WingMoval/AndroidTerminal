<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      AT.HUMAN-ADB-0: ADB runtime / mDNS discovery permissions (minimal set
      needed by AdbRuntime's readiness + NSD discovery). These mirror what
      :adb-engine already declares; explicit here for the product APK.
      DELIBERATELY ABSENT: Accessibility / Foreground Service / Shizuku / root.

      AT.CLI-0.1A: WRITE_SECURE_SETTINGS is a product capability declaration
      (signature|privileged). It lets the app control Settings.Global
      adb_wifi_enabled for post-bootstrap Auto-WD. It is NOT granted on a
      fresh install (FIRST_USE_MANUAL_BOOTSTRAP = REQUIRED): the user manually
      enables WD once, pairs/trusts, and the app then self-grants via
      `pm grant` over its own verified ADB shell. POST_BOOTSTRAP_AUTO_WD = TARGET.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="35" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.ATPreview"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ADB pairing code input window (normal Activity, not overlay). -->
        <activity
            android:name=".PairActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ATPreview" />
    </application>

</manifest>