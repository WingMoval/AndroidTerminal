<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvAdbState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADB: DISCONNECTED"
        android:textStyle="bold"
        android:textColor="#00BFFF" />

    <TextView
        android:id="@+id/tvAdbHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未连接 ADB — 请在 设置→开发者选项→无线调试 开启并配对，然后点 ADB 重试"
        android:textColor="#808080"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvDebugBridge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DebugBridge: -"
        android:textColor="#808080"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="State: - | AndroidTerminal V3 (LOCAL)"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101010">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:text="" />
    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="&lt;" />

        <TextView
            android:id="@+id/tvPage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="- / -"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=">" />

        <Button
            android:id="@+id/btnAddPage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="+" />

        <Button
            android:id="@+id/btnRetryAdb"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ADB" />

        <Button
            android:id="@+id/btnPairAdb"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="配对" />

        <Button
            android:id="@+id/btnClosePage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CLOSE" />
    </LinearLayout>

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:hint="command (e.g. pwd)"
        android:imeOptions="actionSend"
        android:singleLine="true" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnSend"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Send" />

        <Button
            android:id="@+id/btnCtrlC"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Ctrl-C" />

        <Button
            android:id="@+id/btnResize"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Resize" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Clear" />
    </LinearLayout>

</LinearLayout>